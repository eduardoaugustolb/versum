# Copie para .env e preencha os segredos locais:
#   cp .env.example .env
#
# Nunca commite o .env (já está no .gitignore).

PORT=8080
ENVIRONMENT=development
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable"
REDIS_URL="redis://localhost:6379/0"

# Chave AES-GCM usada para cifrar e-mail e payload do outbox.
# Precisa ter 16, 24 ou 32 caracteres (use 32 para AES-256).
# Gere uma com:
#   python3 -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(32)))"
ENCRYPTION_SECRET_KEY=01234567890123456789012345678901
ENCRYPTION_SECRET_VERSION=1

# Durante uma rotação, mantenha as chaves usadas anteriormente neste JSON.
# A chave atual permanece em ENCRYPTION_SECRET_KEY; remova uma chave antiga
# somente depois que nenhum dado cifrado com aquela versão existir mais.
# ENCRYPTION_SECRET_PREVIOUS_KEYS='{"1":"chave-anterior-com-32-caracteres"}'

# Chave HMAC-SHA256 usada para o lookup de e-mail.
# Gere da mesma forma que a chave de criptografia e use um valor diferente dela.
LOOKUP_SECRET_KEY=abcdefghijklmnopqrstuvwxyz123456
LOOKUP_SECRET_VERSION=1

# Durante uma rotação, mantenha as chaves HMAC usadas anteriormente neste JSON.
# LOOKUP_SECRET_PREVIOUS_KEYS='{"1":"chave-hmac-anterior"}'
